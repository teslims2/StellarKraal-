{
  "name": "stellar-kraal-backend",
  "version": "1.0.0",
  "description": "StellarKraal backend API",
  "main": "src/index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "openapi:generate": "node scripts/sync-openapi-version.js",
    "migrate:latest": "db-migrate up --config database.json",
    "migrate:rollback": "db-migrate down --config database.json",
    "migrate:verify": "db-migrate status --config database.json",
    "migrate:dev": "db-migrate up --config database.json --env dev",
    "migrate:prod": "db-migrate up --config database.json",
    "migrate:status": "db-migrate status --config database.json",
    "migrate:down": "db-migrate down --config database.json",
    "migrate:reset": "db-migrate reset --config database.json",
    "migrate:create": "db-migrate create"
  },
  "dependencies": {
    "@apollo/server": "^4.12.2",
    "@stellar/stellar-sdk": "^17.0.1",
    "@types/compression": "^1.8.1",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.60.1",
    "autocannon": "^8.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "db-migrate": "^0.11.14",
    "db-migrate-sqlite3": "^0.4.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.2.0",
    "graphql": "^16.10.0",
    "helmet": "8.3.0",
    "js-yaml": "^5.4.1",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.6",
    "opossum": "^10.0.0",
    "pg": "^8.13.3",
    "prom-client": "^15.1.3",
    "redis": "^5.12.1",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^7.0.0-alpha.0",
    "uuid": "^14.0.2",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.5.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@tsoa/cli": "^7.0.0-alpha.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/node-cron": "3.0.11",
    "@types/opossum": "^8.1.4",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/urijs": "^1.19.26",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.60.1",
    "db-migrate": "^0.11.14",
    "db-migrate-sqlite3": "^1.0.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.5.0",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/src/jest.setup.ts"],
    "moduleFileExtensions": ["ts", "js", "json"],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/**/__tests__/**",
      "!src/**/*.spec.ts"
    ],
    "coverageReporters": ["text-summary", "lcov", "json-summary"],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "functions": 70,
        "branches": 70,
        "statements": 70
      }
    }
  }
}