{
  "name": "stellar-kraal-backend",
  "version": "1.0.0",
  "description": "StellarKraal backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand",
    "openapi:generate": "ts-node scripts/generate-openapi.ts",
    "openapi:sync": "node scripts/sync-openapi-version.js",
    "openapi:check": "npm run openapi:generate && npm run openapi:sync && git diff --exit-code openapi.json || (echo \"ERROR: openapi.json is out of sync with route annotations. Run 'npm run openapi:generate && npm run openapi:sync' and commit the updated openapi.json.\" && exit 1)"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.5",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}