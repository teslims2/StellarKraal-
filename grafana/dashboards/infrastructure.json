{
  "title": "StellarKraal — Infrastructure",
  "uid": "stellarkraal-infrastructure",
  "description": "CPU, memory, disk, network, and container health across all StellarKraal services. Provisioned via grafana/dashboards/ — do not edit in the UI.",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage by Service (%)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total[1m])) by (name) * 100",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      }
    },
    {
      "id": 2,
      "title": "Memory Usage by Service (MiB)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes) by (name) / 1024 / 1024",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "mebibytes", "min": 0 }
      }
    },
    {
      "id": 3,
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 }
      }
    },
    {
      "id": 4,
      "title": "HTTP Error Rate (5xx/s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[1m]))",
          "legendFormat": "5xx/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Disk Read Throughput (MiB/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "sum(rate(container_fs_reads_bytes_total[1m])) by (name) / 1024 / 1024",
          "legendFormat": "{{name}} read"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "MBs", "min": 0 }
      }
    },
    {
      "id": 6,
      "title": "Disk Write Throughput (MiB/s)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "sum(rate(container_fs_writes_bytes_total[1m])) by (name) / 1024 / 1024",
          "legendFormat": "{{name}} write"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "MBs", "min": 0 }
      }
    },
    {
      "id": 7,
      "title": "Network Receive (MiB/s)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total[1m])) by (name) / 1024 / 1024",
          "legendFormat": "{{name}} rx"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "MBs", "min": 0 }
      }
    },
    {
      "id": 8,
      "title": "Container Restart Count",
      "type": "stat",
      "gridPos": { "x": 0, "y": 22, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_restarts_total) by (container)",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Redis Hit Rate (%)",
      "type": "gauge",
      "gridPos": { "x": 8, "y": 22, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[1m]) / (rate(redis_keyspace_hits_total[1m]) + rate(redis_keyspace_misses_total[1m])) * 100",
          "legendFormat": "hit rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "PostgreSQL Active Connections",
      "type": "stat",
      "gridPos": { "x": 16, "y": 22, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{state=\"active\"}",
          "legendFormat": "active connections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    }
  ]
}
